# Copie este arquivo para .env e preencha. O .env nunca vai pro GitHub.

# Gere uma chave nova com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-gerada

# No seu computador: True. No PythonAnywhere: False.
DEBUG=True

# Domínios do site, separados por vírgula. No computador pode deixar vazio.
# No PythonAnywhere: SEUUSUARIO.pythonanywhere.com
ALLOWED_HOSTS=
